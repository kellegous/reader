#!/usr/bin/env python3

import argparse
import os
import sys
import subprocess

parser = argparse.ArgumentParser()
parser.add_argument("--port", type=int, default=4040)
parser.add_argument("--volume", type=str, default="reader-data")
args = parser.parse_args()

arch = subprocess.run(
    ["go", "env", "GOARCH"], capture_output=True, text=True
).stdout.strip()

here = os.path.dirname(os.path.abspath(__file__))
root = os.path.dirname(here)

subprocess.run(
    [
        "docker",
        "run",
        "-ti",
        "--rm",
        "--platform",
        f"linux/{arch}",
        "-v",
        f"{root}:/src",
        "-v",
        f"{args.volume}:/data",
        "-p",
        f"{args.port}:4040",
        "-w",
        "/src",
        "kellegous/build:a4dd431e",
        "/bin/bash",
        "/src/etc/setup-dev.sh",
    ],
)
